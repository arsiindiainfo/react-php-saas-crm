#--------------------------------------------------------------------
# Copy this file to `.env` and adjust values for your machine.
# `.env` itself is git-ignored — never commit real secrets.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# DATABASE — matches infrastructure/docker-compose.yml's `mysql` service
# (mapped to host port 3307, not the default 3306, to avoid clashing with
# any local MySQL/XAMPP/other-project instance already using 3306)
#--------------------------------------------------------------------

 database.default.hostname = localhost
 database.default.database = arsi_react_php_saas_crm
 database.default.username = root
 database.default.password =
 database.default.DBDriver = MySQLi
 database.default.DBPrefix =
 database.default.port = 3307

 database.tests.hostname = localhost
 database.tests.database = arsi_react_php_saas_crm_test
 database.tests.username = root
 database.tests.password =
 database.tests.DBDriver = MySQLi
 database.tests.DBPrefix =
 database.tests.charset = utf8mb4
 database.tests.DBCollat = utf8mb4_0900_ai_ci
 database.tests.port = 3307

#--------------------------------------------------------------------
# CRM (auth / mail)
#--------------------------------------------------------------------

# Generate a real secret for anything beyond local dev, e.g.:
#   php -r "echo bin2hex(random_bytes(32));"
 JWT_SECRET = replace-with-a-random-secret

# Google reCAPTCHA v2 secret key, verified server-side on POST /auth/login
# (App\Filters\RecaptchaFilter). Get a key pair at https://www.google.com/recaptcha/admin
# The matching public site key goes in frontend/.env as VITE_RECAPTCHA_SITE_KEY.
# Leave blank to disable the check entirely (e.g. for local dev without a key).
 RECAPTCHA_SECRET_KEY =

# Mailhog (see infrastructure/docker-compose.yml) catches user-invite emails locally
 email.protocol = smtp
 email.SMTPHost = localhost
 email.SMTPPort = 1025
 email.fromEmail = no-reply@arsi-crm.test
 email.fromName = "Arsi India Info CRM"

# Invite email sent via ResendMailer in production (Mailhog above, locally).
# Only read when CI_ENVIRONMENT=production — leave blank locally.
 resend.apiKey =

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =
